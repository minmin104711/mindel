---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import site from '../data/site.json';
import Menu from '../components/Menu.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.intro } = Astro.props;
const pageTitle = title ? `${title} — MINDEL` : 'MINDEL';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
      // 메인 배경 선 애니메이션: 사이트를 새로 열거나 새로고침할 때마다 (같은 창에서 돌아올 때는 X)
      try {
        var nav = performance.getEntriesByType('navigation')[0];
        var reload = nav && nav.type === 'reload';
        if (location.pathname === '/') {
          if (reload || !sessionStorage.getItem('mindel-drawn')) {
            document.documentElement.classList.add('draw');
          }
          sessionStorage.setItem('mindel-drawn', '1');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="header wrap">
      <a href="/" class="logo">MINDEL</a>
      <Menu />
    </header>

    <main>
      <slot />
    </main>

    <footer id="contact" class="footer wrap">
      <p class="footer-label">Contact</p>
      <a class="footer-mail" href={`mailto:${site.email}`}>{site.email}</a>
      <p class="footer-copy">© {new Date().getFullYear()} MINDEL</p>
    </footer>

    <script>
      // 화면에 들어온 요소에 .is-visible을 붙여서 올라오는 모션을 실행해요
      const items = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.01 }
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 60px;
    padding-top: env(safe-area-inset-top);
    background: linear-gradient(#000 40%, rgba(0, 0, 0, 0));
    font-size: 14px;
  }
  .logo { font-weight: 600; letter-spacing: 0.08em; }

  .footer {
    margin-top: 120px;
    padding-top: 40px;
    padding-bottom: calc(40px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
  }
  .footer-label { font-size: 13px; color: var(--muted); margin-bottom: 12px; }
  .footer-mail {
    display: inline-block;
    font-size: clamp(20px, 5vw, 40px);
    font-weight: 600;
    letter-spacing: -0.02em;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .footer-mail:hover { border-color: var(--fg); }
  .footer-copy { margin-top: 64px; font-size: 12px; color: var(--muted); }
</style>
