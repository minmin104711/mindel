---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getWorks } from '../../lib';
import { categoryOf } from '../../categories';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work, i) => ({
    params: { slug: work.id },
    props: {
      work,
      next: works[(i + 1) % works.length],
      // 목록에서 고른 종류 안에서 "다음"을 고를 수 있게 전체 순서를 넘겨요
      order: works.map((w) => ({ id: w.id, title: w.data.title, category: categoryOf(w.data.category).key })),
    },
  }));
}

const { work, next, order } = Astro.props;
const { title, category, year, cover, images, description, period, contribution, tools, model } = work.data;
// 대표 이미지 아래 정보: 비어 있는 줄은 빼요
const facts = [
  ['Period', period],
  ['Contribution', contribution],
  ['Tools', tools],
  ['Model', model],
].filter(([, v]) => v && v.trim());
// PC에서도 태블릿 정도 폭(820px)으로만 보여요
const sizes = '(min-width: 900px) 820px, 100vw';
---

<Base title={title} description={description || title}>
  <article class="wrap detail">
    <header class="head">
      <a href="/#works-title" class="back">← Works</a>
      <h1 class="line" style="--i:0">{title}</h1>
      <p class="info line" style="--i:1">{categoryOf(category).label} · {year}</p>
    </header>

    <!-- 순서: 제목 → 대표 이미지 → 작업 정보 → 설명 → 상세 이미지 -->
    <Image class="cover line" style="--i:2" src={cover} alt={title} widths={[640, 1080, 1600, 2000]} sizes={sizes} loading="eager" format="webp" quality={82} />

    {(facts.length > 0 || description) && (
      <div class="about">
        {facts.length > 0 && (
          <dl class="facts reveal">
            {facts.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        )}
        {description && <p class="desc reveal">{description}</p>}
      </div>
    )}

    <div class="images">
      {images.map((img, i) => (
        <Image class="reveal" src={img} alt={`${title} 상세 이미지 ${i + 1}`} widths={[640, 1080, 1600, 2000]} sizes={sizes} format="webp" quality={82} />
      ))}
    </div>

    {next && next.id !== work.id && (
      <a href={`/works/${next.id}/`} class="next" data-current={work.id} data-order={JSON.stringify(order)}>
        <span>Next</span>
        <strong>{next.data.title}</strong>
      </a>
    )}
  </article>
</Base>

<script>
  import { CATEGORIES } from '../../categories';
  // 목록에서 종류(그래픽/사진/패키지)를 골라 두었으면, 그 종류 안에서 다음 작업물로 넘어가요
  const link = document.querySelector<HTMLAnchorElement>('.next');
  let filter = 'all';
  try { filter = sessionStorage.getItem('mindel-filter') || 'all'; } catch {}

  if (link && filter !== 'all') {
    const order: { id: string; title: string; category: string }[] = JSON.parse(link.dataset.order!);
    const label = CATEGORIES.find((c) => c.key === filter)?.label ?? filter;
    const list = order.filter((w) => w.category === filter);
    const i = list.findIndex((w) => w.id === link.dataset.current);

    if (i !== -1) {
      const labelEl = link.querySelector('span')!;
      const title = link.querySelector('strong')!;
      if (list.length > 1) {
        const next = list[(i + 1) % list.length];
        link.href = `/works/${next.id}/`;
        labelEl.textContent = `Next · ${label}`;
        title.textContent = next.title;
      } else {
        // 이 종류에 작업물이 하나뿐이면 목록으로
        link.href = '/#works-title';
        labelEl.textContent = label;
        title.textContent = '← Back';
      }
    }
  }
</script>

<style>
  /* PC에서는 가운데 820px만 쓰고 양옆은 여백 */
  .detail { max-width: calc(820px + var(--gutter) * 2); }
  .head { padding: 40px 0 32px; }
  .back {
    display: inline-block;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 40px;
    transition: color 0.2s;
  }
  .back:hover { color: var(--fg); }
  h1 {
    font-size: clamp(28px, 7vw, 56px);
    line-height: 1.25;
    letter-spacing: -0.03em;
  }
  .info { margin-top: 10px; font-size: 14px; color: var(--muted); }
  .about { margin: 32px 0 56px; }
  .facts { margin: 0; display: grid; gap: 6px; font-size: 15px; line-height: 1.6; }
  .facts div { display: grid; grid-template-columns: 120px 1fr; gap: 12px; }
  .facts dt { font-weight: 700; }
  .facts dd { margin: 0; font-weight: 400; color: rgba(255, 255, 255, 0.85); }
  .desc { font-size: 16px; line-height: 1.75; color: rgba(255, 255, 255, 0.85); white-space: pre-line; }
  .facts + .desc { margin-top: 28px; }

  .images { display: grid; gap: 12px; }
  .cover, .images :global(img) {
    width: 100%;
    background: #111;
    /* 피그마 내보내기 등으로 가장자리에 생기는 얇은 밝은 줄을 가려요 (가장자리 2px) */
    clip-path: inset(2px);
  }
  /* 설명이 없으면 대표 이미지와 상세 이미지 사이는 이미지 간격만큼 */
  .cover + .images { margin-top: 12px; }
  @media (min-width: 768px) {
    .images { gap: 24px; }
    .cover + .images { margin-top: 24px; }
  }

  .next {
    display: block;
    margin-top: 96px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .next span { display: block; font-size: 13px; color: var(--muted); margin-bottom: 8px; }
  .next strong { font-size: clamp(22px, 5vw, 36px); font-weight: 600; letter-spacing: -0.02em; }
</style>
