---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroLines from '../components/HeroLines.astro';
import site from '../data/site.json';
import { getWorks } from '../lib';
import { CATEGORIES, categoryOf } from '../categories';

const works = await getWorks();
// 종류별 버튼 (메뉴와 같은 순서)
const categories = CATEGORIES.map((c) => ({
  ...c,
  count: works.filter((w) => w.data.category === c.ko).length,
}));
// 소개 문장에서 줄바꿈(엔터)마다 한 줄씩 나타나요
const lines = site.intro.split('\n').map((l) => l.trim()).filter(Boolean);
---

<Base>
  <section class="hero">
    <HeroLines />
    <div class="intro wrap">
    <h1 class="intro-text">
      {lines.map((line, i) => <span class="line" style={`--i:${i}`}>{line}</span>)}
    </h1>
    {site.subtitle && (
      <p class="intro-sub line" style={`--i:${lines.length + 1}`}>{site.subtitle}</p>
    )}
    </div>
  </section>

  <section class="works wrap" aria-labelledby="works-title">
    <h2 id="works-title" class="works-title">Works</h2>
    <div class="filters" role="group" aria-label="Filter works">
      <button type="button" class="filter" data-filter="all" aria-pressed="true">
        All<sup>{works.length}</sup>
      </button>
      {categories.map((c) => (
        <button type="button" class="filter" data-filter={c.key} aria-pressed="false">
          {c.label}<sup>{c.count}</sup>
        </button>
      ))}
    </div>
    <ul class="grid">
      {works.map((work, i) => (
        <li class="reveal" data-category={categoryOf(work.data.category).key}>
          <a href={`/works/${work.id}/`} class="card">
            <div class="thumb">
              <Image
                src={work.data.cover}
                alt={work.data.title}
                widths={[400, 600, 800]}
                sizes="(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 50vw"
                loading={i < 4 ? 'eager' : 'lazy'}
                format="webp"
                quality={80}
              />
            </div>
            <div class="meta">
              <h3>{work.data.title}</h3>
              <p>{categoryOf(work.data.category).label} · {work.data.year}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="empty" hidden>Coming soon.</p>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const items = document.querySelectorAll<HTMLElement>('.grid > li');
  const empty = document.querySelector<HTMLElement>('.empty')!;
  const KEY = 'mindel-filter';

  function apply(filter: string, animate: boolean) {
    if (![...buttons].some((b) => b.dataset.filter === filter)) filter = 'all';
    buttons.forEach((b) => {
      const on = b.dataset.filter === filter;
      b.setAttribute('aria-pressed', String(on));
      // 고른 버튼이 화면 밖에 있으면 보이도록 옆으로 밀어줘요 (휴대폰)
      if (on && b.parentElement!.scrollWidth > b.parentElement!.clientWidth) {
        b.parentElement!.scrollTo({ left: b.offsetLeft - b.parentElement!.offsetLeft - 20, behavior: animate ? 'smooth' : 'auto' });
      }
    });
    let visible = 0;
    items.forEach((li) => {
      const show = filter === 'all' || li.dataset.category === filter;
      if (show) visible++;
      li.hidden = !show;
      if (show && animate) {
        // 보이는 작업물만 살짝 올라오며 다시 나타나요
        li.classList.remove('is-visible', 'pop');
        void li.offsetWidth;
        li.classList.add('is-visible', 'pop');
      }
    });
    empty.hidden = visible > 0;
    try { sessionStorage.setItem(KEY, filter); } catch {}
  }

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!, true)));

  // 메뉴에서 이 화면에 있을 때 종류를 누르면 바로 바꿔요
  window.addEventListener('mindel:filter', (e) => apply((e as CustomEvent<string>).detail, true));

  // 메뉴에서 다른 페이지에 있다가 종류를 누르면 /?type=graphic 처럼 들어와요.
  // 아니면 상세 페이지에서 돌아왔을 때 고른 종류를 그대로 유지해요.
  const params = new URLSearchParams(location.search);
  let saved = 'all';
  try { saved = sessionStorage.getItem(KEY) || 'all'; } catch {}
  const initial = params.get('type') || saved;
  if (initial !== 'all') apply(initial, false);
  else if (params.has('type')) apply('all', false);
  if (params.has('type')) history.replaceState(null, '', '/' + location.hash);
</script>

<style>
  .hero {
    position: relative;
    margin-top: -60px;
    padding-top: 60px;
  }
  .intro {
    position: relative;
    min-height: calc(88svh - 60px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: 64px;
  }
  .intro-text {
    font-size: clamp(30px, 8.4vw, 76px);
    line-height: 1.28;
    letter-spacing: -0.03em;
    max-width: 16em;
  }
  .intro-sub {
    margin-top: 24px;
    font-size: 14px;
    color: var(--muted);
  }

  .works { padding-top: 32px; border-top: 1px solid var(--line); }
  .works-title {
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
    margin-bottom: 24px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin: -8px 0 32px;
  }
  /* 휴대폰: 한 줄로 두고 옆으로 밀어서 보기 */
  @media (max-width: 767px) {
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      /* 화면 끝까지 밀리도록 양옆 여백만큼 넓히기 */
      margin-left: calc(var(--gutter) * -1);
      margin-right: calc(var(--gutter) * -1);
      padding: 0 var(--gutter);
      scroll-padding: 0 var(--gutter);
      /* 오른쪽 끝을 살짝 흐리게: 옆에 더 있다는 표시 */
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 48px), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 48px), transparent);
    }
    .filters::-webkit-scrollbar { display: none; }
    .filter { flex: none; white-space: nowrap; }
    .filter:last-child { margin-right: 24px; }
  }
  .filter {
    appearance: none;
    background: none;
    border: 0;
    padding: 8px 0;
    font: inherit;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.25s;
    -webkit-tap-highlight-color: transparent;
  }
  .filter sup {
    margin-left: 3px;
    font-size: 11px;
    font-weight: 400;
    vertical-align: 0.6em;
  }
  .filter[aria-pressed='true'] { color: var(--fg); }
  @media (hover: hover) {
    .filter:hover { color: var(--fg); }
  }

  .grid > li[hidden] { display: none; }
  .empty { padding: 24px 0 8px; font-size: 14px; color: var(--muted); }
  .grid > li.pop { animation: pop-in 0.6s var(--ease); }
  @keyframes pop-in {
    from { opacity: 0; transform: translate3d(0, 16px, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .grid > li.pop { animation: none; }
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 12px;
  }
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(3, 1fr); gap: 40px 20px; } }
  @media (min-width: 1200px) { .grid { grid-template-columns: repeat(4, 1fr); } }

  .thumb {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #111;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: inset(1px); /* 가장자리 얇은 밝은 줄 가리기 */
    transition: transform 0.8s var(--ease);
  }
  @media (hover: hover) {
    .card:hover .thumb :global(img) { transform: scale(1.03); }
  }
  .meta { margin-top: 10px; }
  .meta h3 {
    font-size: 14px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .meta p { margin-top: 2px; font-size: 12px; color: var(--muted); }
  @media (min-width: 768px) {
    .meta h3 { font-size: 15px; }
    .meta p { font-size: 13px; }
  }
</style>
