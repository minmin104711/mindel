---
// 메인 배경 라인 그림.
// 그림을 바꾸려면 src/assets/hero-lines.svg 파일만 교체하면 돼요 (선은 "획(Stroke)"이어야 해요).
// 애니메이션: 중심(아래 CSS의 --cx, --cy)에서 먹이 번지듯 둥글게 퍼지며 선이 드러나요.
import raw from '../assets/hero-lines.svg?raw';

const viewBox = raw.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 1920 1080';

// 숫자를 소수점 한 자리로 줄여서 파일을 가볍게
const compact = (d: string) =>
  d
    .replace(/,/g, ' ')
    .replace(/-?(?:\d+\.?\d*|\.\d+)(?:e-?\d+)?/gi, (n) => {
      const v = String(Math.round(parseFloat(n) * 10) / 10).replace(/^(-?)0\./, '$1.');
      return v.startsWith('-') ? v : ` ${v}`;
    })
    .replace(/\s+/g, ' ')
    .replace(/ ?([a-zA-Z-]) ?/g, (_, c) => (c === '-' ? '-' : c))
    .trim();

const paths = [...raw.matchAll(/<path[^>]*\sd="([^"]+)"/g)]
  .map((m) => `<path d="${compact(m[1])}"/>`)
  .join('');
---

<div class="art" aria-hidden="true">
  <div class="ink">
    <svg viewBox={viewBox} fill="none" preserveAspectRatio="xMidYMid meet" set:html={paths} />
  </div>
</div>

<style>
  @property --ink {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 120%;
  }

  .art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* 아래쪽은 부드럽게 사라지게 */
    -webkit-mask-image: linear-gradient(#000 70%, transparent);
    mask-image: linear-gradient(#000 70%, transparent);
  }

  .ink {
    /* 퍼져나가는 중심: 민들레 중심 (원본 그림의 1260, 545 지점) */
    --cx: 65.6%;
    --cy: 50.5%;
    position: absolute;
    top: 50%;
    /* 휴대폰: 민들레 중심이 화면 가운데 오도록 크게 */
    left: 50%;
    height: 72%;
    aspect-ratio: 16 / 9;
    transform: translate(-65.6%, -58%);
    will-change: transform;
    -webkit-mask-image:
      linear-gradient(#000 60%, transparent),
      radial-gradient(circle farthest-corner at var(--cx) var(--cy), #000 calc(var(--ink) - 14%), transparent var(--ink));
    mask-image:
      linear-gradient(#000 60%, transparent),
      radial-gradient(circle farthest-corner at var(--cx) var(--cy), #000 calc(var(--ink) - 14%), transparent var(--ink));
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    stroke: #fff;
    stroke-opacity: 0.42;
    stroke-width: 2.2; /* 원본 그림 기준 두께 (휴대폰 화면에서 약 1px) */
    stroke-linecap: round;
    stroke-linejoin: round;
    will-change: transform;
  }

  @media (min-width: 768px) {
    .ink {
      left: 0;
      width: 100%;
      height: auto;
      max-height: 100%;
      transform: translateY(-50%);
    }
    svg { stroke-width: 1.4; }
  }

  /* 새로 열거나 새로고침할 때: 중심에서 먹이 번지듯 퍼져요 */
  :global(html.draw) .ink {
    animation: ink 4.2s cubic-bezier(0.3, 0.3, 0.2, 1) 0.15s both;
  }
  @keyframes ink {
    from { --ink: 0%; }
    to { --ink: 120%; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.draw) .ink { animation: none; }
  }
</style>
