---
// 메인 배경 라인 그림.
// 그림을 바꾸려면 src/assets/hero-lines.svg 파일만 교체하면 돼요 (선은 "획(Stroke)"이어야 해요).
//
// 애니메이션: 중심(CENTER)에서 퍼져나가는 경계가 닿는 순간,
// 각 선이 "중심에 가장 가까운 지점"에서 시작해 양쪽 끝으로 펜으로 긋듯 그려져요.
// 펜 속도 = 경계가 퍼지는 속도라서, 바깥쪽 선이 먼저 그려지는 일이 없어요.
import raw from '../assets/hero-lines.svg?raw';

const CENTER = { x: 1260, y: 545 }; // 민들레 중심 (원본 그림 좌표)
const SPEED = 420; // 퍼지는 속도 (원본 그림 좌표 기준, 1초에 이동하는 거리)
const START = 0.15; // 시작 전 잠깐 기다리는 시간(초)

type P = { x: number; y: number };
type Seg = [P, P, P, P]; // 3차 베지어 곡선 한 조각

const viewBox = raw.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 1920 1080';

// ── SVG path 해석: 모든 명령을 3차 베지어 조각으로 바꿔요 ──
function parse(d: string): Seg[][] {
  const tokens = d.match(/[a-zA-Z]|-?(?:\d+\.?\d*|\.\d+)(?:e-?\d+)?/gi) ?? [];
  const subpaths: Seg[][] = [];
  let segs: Seg[] = [];
  let cur: P = { x: 0, y: 0 };
  let start: P = cur;
  let lastC: P | null = null; // S 명령용
  let lastQ: P | null = null; // T 명령용
  let cmd = '';
  let i = 0;
  const num = () => parseFloat(tokens[i++]);
  const line = (a: P, b: P): Seg => [a, lerp(a, b, 1 / 3), lerp(a, b, 2 / 3), b];

  while (i < tokens.length) {
    if (/[a-zA-Z]/.test(tokens[i])) cmd = tokens[i++];
    const rel = cmd === cmd.toLowerCase();
    const o = rel ? cur : { x: 0, y: 0 };
    const pt = () => ({ x: o.x + num(), y: o.y + num() });
    const C = cmd.toUpperCase();
    let next: P;

    if (C === 'M') {
      if (segs.length) subpaths.push(segs);
      segs = [];
      cur = start = pt();
      cmd = rel ? 'l' : 'L'; // M 뒤에 이어지는 좌표는 선(L)
      lastC = lastQ = null;
      continue;
    } else if (C === 'L') {
      next = pt();
      segs.push(line(cur, next));
      lastC = lastQ = null;
    } else if (C === 'H') {
      next = { x: (rel ? cur.x : 0) + num(), y: cur.y };
      segs.push(line(cur, next));
      lastC = lastQ = null;
    } else if (C === 'V') {
      next = { x: cur.x, y: (rel ? cur.y : 0) + num() };
      segs.push(line(cur, next));
      lastC = lastQ = null;
    } else if (C === 'C') {
      const c1 = pt(), c2 = pt();
      next = pt();
      segs.push([cur, c1, c2, next]);
      lastC = c2; lastQ = null;
    } else if (C === 'S') {
      const c1 = lastC ? { x: 2 * cur.x - lastC.x, y: 2 * cur.y - lastC.y } : cur;
      const c2 = pt();
      next = pt();
      segs.push([cur, c1, c2, next]);
      lastC = c2; lastQ = null;
    } else if (C === 'Q' || C === 'T') {
      const q = C === 'Q' ? pt() : lastQ ? { x: 2 * cur.x - lastQ.x, y: 2 * cur.y - lastQ.y } : cur;
      next = pt();
      segs.push([cur, lerp(cur, q, 2 / 3), lerp(next, q, 2 / 3), next]);
      lastQ = q; lastC = null;
    } else if (C === 'Z') {
      if (Math.hypot(cur.x - start.x, cur.y - start.y) > 0.01) segs.push(line(cur, start));
      next = start;
      lastC = lastQ = null;
    } else {
      i++; // 지원하지 않는 명령(A 등)은 건너뛰어요
      continue;
    }
    cur = next;
  }
  if (segs.length) subpaths.push(segs);
  return subpaths;
}

const lerp = (a: P, b: P, t: number): P => ({ x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t });

function at([a, b, c, d]: Seg, t: number): P {
  const u = 1 - t;
  return {
    x: u * u * u * a.x + 3 * u * u * t * b.x + 3 * u * t * t * c.x + t * t * t * d.x,
    y: u * u * u * a.y + 3 * u * u * t * b.y + 3 * u * t * t * c.y + t * t * t * d.y,
  };
}

function split([a, b, c, d]: Seg, t: number): [Seg, Seg] {
  const ab = lerp(a, b, t), bc = lerp(b, c, t), cd = lerp(c, d, t);
  const abc = lerp(ab, bc, t), bcd = lerp(bc, cd, t);
  const m = lerp(abc, bcd, t);
  return [[a, ab, abc, m], [m, bcd, cd, d]];
}

const reverse = (segs: Seg[]): Seg[] => segs.slice().reverse().map(([a, b, c, d]) => [d, c, b, a]);

function length(segs: Seg[]) {
  let len = 0;
  for (const s of segs) {
    let prev = s[0];
    for (let k = 1; k <= 12; k++) {
      const p = at(s, k / 12);
      len += Math.hypot(p.x - prev.x, p.y - prev.y);
      prev = p;
    }
  }
  return len;
}

const dist = (p: P) => Math.hypot(p.x - CENTER.x, p.y - CENTER.y);

// 중심에 가장 가까운 지점 (조각 번호, 위치 t)
function nearest(segs: Seg[]) {
  let best = { k: 0, t: 0, d: Infinity };
  segs.forEach((s, k) => {
    for (let n = 0; n <= 16; n++) {
      const d = dist(at(s, n / 16));
      if (d < best.d) best = { k, t: n / 16, d };
    }
  });
  // 주변을 더 촘촘히 찾아서 정확하게
  const s = segs[best.k];
  for (let n = -10; n <= 10; n++) {
    const t = Math.min(1, Math.max(0, best.t + n / 160));
    const d = dist(at(s, t));
    if (d < best.d) best = { ...best, t, d };
  }
  return best;
}

// 좌표를 소수점 한 자리로, 상대좌표(c)로 써서 파일을 가볍게
const r1 = (v: number) => Math.round(v * 10) / 10;
const fmt = (v: number) => {
  const s = String(r1(v) || 0).replace(/^(-?)0\./, '$1.');
  return s.startsWith('-') ? s : ` ${s}`;
};
function toD(segs: Seg[]) {
  let px = r1(segs[0][0].x), py = r1(segs[0][0].y);
  let d = `M${fmt(px)}${fmt(py)}c`;
  for (const [, b, c, e] of segs) {
    const ex = r1(e.x), ey = r1(e.y);
    d += fmt(b.x - px) + fmt(b.y - py) + fmt(c.x - px) + fmt(c.y - py) + fmt(ex - px) + fmt(ey - py);
    px = ex; py = ey;
  }
  return d.replace(/([Mc]) /g, '$1');
}

// ── 선마다: 중심에 가장 가까운 지점에서 둘로 나눠 양쪽 끝으로 그려지게 ──
const strokes: { d: string; delay: number; dur: number }[] = [];
for (const m of raw.matchAll(/<path[^>]*\sd="([^"]+)"/g)) {
  for (const segs of parse(m[1])) {
    const { k, t, d } = nearest(segs);
    const [left, right] = split(segs[k], t);
    const parts = [
      [right, ...segs.slice(k + 1)], // 가까운 지점 → 끝
      reverse([...segs.slice(0, k), left]), // 가까운 지점 → 시작
    ];
    for (const part of parts) {
      const len = length(part);
      if (len < 0.5) continue;
      strokes.push({ d: toD(part), delay: START + d / SPEED, dur: Math.max(0.12, len / SPEED) });
    }
  }
}
strokes.sort((a, b) => a.delay - b.delay);

const paths = strokes
  .map((s) => `<path d="${s.d}" pathLength="1" style="--t:${s.delay.toFixed(2)}s;--u:${s.dur.toFixed(2)}s"/>`)
  .join('');
---

<div class="art" aria-hidden="true">
  <svg viewBox={viewBox} fill="none" preserveAspectRatio="xMidYMid meet" set:html={paths} />
</div>

<style>
  .art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* 아래쪽은 부드럽게 사라지게 */
    -webkit-mask-image: linear-gradient(#000 70%, transparent);
    mask-image: linear-gradient(#000 70%, transparent);
  }

  svg {
    position: absolute;
    top: 50%;
    /* 휴대폰: 민들레 중심이 화면 가운데 오도록 크게 */
    left: 50%;
    height: 72%;
    width: auto;
    aspect-ratio: 16 / 9;
    transform: translate(-65.6%, -58%);
    stroke: #fff;
    stroke-opacity: 0.42;
    stroke-width: 2.2; /* 원본 그림 기준 두께 (휴대폰 화면에서 약 1px) */
    stroke-linecap: round;
    stroke-linejoin: round;
    /* 그림 자체의 아래쪽 끝도 부드럽게 */
    -webkit-mask-image: linear-gradient(#000 60%, transparent);
    mask-image: linear-gradient(#000 60%, transparent);
  }

  @media (min-width: 768px) {
    svg {
      left: 0;
      width: 100%;
      height: auto;
      max-height: 100%;
      transform: translateY(-50%);
      stroke-width: 1.4;
    }
  }

  /* 새로 열거나 새로고침할 때: 중심에서 바깥으로, 펜으로 긋듯 그려져요 */
  :global(html.draw) svg :global(path) {
    stroke-dasharray: 1 1;
    animation: draw var(--u) linear var(--t) both;
  }
  /* 시작 전에는 완전히 숨겨서 점이 미리 보이지 않게 */
  @keyframes draw {
    from { stroke-dashoffset: 1; visibility: hidden; }
    to { stroke-dashoffset: 0; visibility: visible; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.draw) svg :global(path) { animation: none; }
  }
</style>
