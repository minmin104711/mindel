---
// 메인 배경 라인 그림.
// 그림을 바꾸려면 src/assets/hero-lines.svg 파일만 교체하면 돼요 (선은 "획(Stroke)"이어야 해요).
// 사이트를 만들 때 선마다 길이와 위치를 계산해서,
// 중심(CENTER)에 가까운 선부터 바깥쪽으로 차례로 그려지게 해요.
import { svgPathProperties } from 'svg-path-properties';
import raw from '../assets/hero-lines.svg?raw';

// 퍼져나가기 시작하는 점 (원본 그림 좌표, 민들레 중심)
const CENTER = { x: 1260, y: 545 };
const SPREAD = 2.4; // 가장 바깥 선이 시작하기까지 걸리는 시간(초)

const viewBox = raw.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 1920 1080';

// 숫자를 소수점 한 자리로 줄여서 파일을 가볍게
const compact = (d: string) =>
  d
    .replace(/,/g, ' ')
    .replace(/-?(?:\d+\.?\d*|\.\d+)(?:e-?\d+)?/gi, (n) => {
      const v = String(Math.round(parseFloat(n) * 10) / 10).replace(/^(-?)0\./, '$1.');
      return v.startsWith('-') ? v : ` ${v}`;
    })
    .replace(/\s+/g, ' ')
    .replace(/ ?([a-zA-Z-]) ?/g, (_, c) => (c === '-' ? '-' : c))
    .trim();

const dist = (p: { x: number; y: number }) => Math.hypot(p.x - CENTER.x, p.y - CENTER.y);

const items = [...raw.matchAll(/<path[^>]*\sd="([^"]+)"/g)].map((m) => {
  const d = m[1];
  const props = new svgPathProperties(d);
  const len = props.getTotalLength();
  const ds = dist(props.getPointAtLength(0));
  const de = dist(props.getPointAtLength(len));
  return { d: compact(d), len, near: Math.min(ds, de), reverse: de < ds };
});

const maxNear = Math.max(...items.map((i) => i.near), 1);

const paths = items
  .sort((a, b) => a.near - b.near)
  .map((i) => {
    const delay = (i.near / maxNear) ** 0.85 * SPREAD;
    const dur = 0.5 + Math.min(i.len / 500, 1) * 0.9;
    return `<path d="${i.d}" pathLength="1"${i.reverse ? ' class="r"' : ''} style="--t:${delay.toFixed(2)}s;--u:${dur.toFixed(2)}s"/>`;
  })
  .join('');
---

<div class="art" aria-hidden="true">
  <svg viewBox={viewBox} fill="none" preserveAspectRatio="xMidYMid meet" set:html={paths} />
</div>

<style>
  .art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* 아래쪽은 부드럽게 사라지게 */
    -webkit-mask-image: linear-gradient(#000 70%, transparent);
    mask-image: linear-gradient(#000 70%, transparent);
  }
  svg {
    position: absolute;
    top: 50%;
    /* 휴대폰: 민들레 중심이 화면 가운데 오도록 크게 */
    left: 50%;
    height: 72%;
    width: auto;
    aspect-ratio: 16 / 9;
    transform: translate(-65.6%, -58%);
    stroke: #fff;
    stroke-opacity: 0.42;
    stroke-width: 2.2; /* 원본 그림 기준 두께 (휴대폰 화면에서 약 1px) */
    stroke-linecap: round;
    stroke-linejoin: round;
    /* 그림 자체의 아래쪽 끝도 부드럽게 */
    -webkit-mask-image: linear-gradient(#000 60%, transparent);
    mask-image: linear-gradient(#000 60%, transparent);
  }

  @media (min-width: 768px) {
    svg {
      left: 0;
      width: 100%;
      height: auto;
      max-height: 100%;
      transform: translateY(-50%);
      stroke-width: 1.4;
    }
  }

  /* 처음 방문할 때만: 선이 중심에서 바깥으로 그려져요 */
  :global(html.draw) svg :global(path) {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    animation: draw var(--u) cubic-bezier(0.45, 0, 0.25, 1) var(--t) forwards;
  }
  :global(html.draw) svg :global(path.r) {
    stroke-dashoffset: -1;
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.draw) svg :global(path) { animation: none; stroke-dashoffset: 0; }
  }
</style>
